# Copy to .env.local (never committed). Values here are for local development only.

# The running app's database login: a member of app_runtime (cannot delete, truncate, alter or disable triggers).
DATABASE_URL=postgres://tennissa_app:tennissa_app_dev@localhost:54329/tennissa
# The database owner, for migrations and seeding ONLY. Never read by the running app.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:54329/tennissa
# Password given to the tennissa_app login by `npm run db:migrate` (local only).
APP_DB_PASSWORD=tennissa_app_dev

APP_URL=http://localhost:3000
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=

# Sign-in provider. "dev" = local magic links shown in the dev outbox (refused in production).
# Supabase Auth replaces it once the project exists.
AUTH_PROVIDER=dev
SESSION_IDLE_MINUTES=30

# Stripe, TEST MODE keys only until launch (Dashboard > Developers > API keys).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (or the Dashboard webhook endpoint).
STRIPE_WEBHOOK_SECRET=
# Optional: a second secret for the Connect webhook endpoint, if you configure one.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Connected accounts (acct_...). Leave blank to charge on the platform account in test mode.
STRIPE_ACCOUNT_25F_TN=
STRIPE_ACCOUNT_GENERAL=

# Email. Blank = emails are written to .dev-outbox/ instead of sent.
RESEND_API_KEY=
EMAIL_FROM="TENNISSA <receipts@example.org>"

# Giving opens after this moment (America/Chicago). Gifts before 2027 are never §25F.
GIVING_OPENS_AT=2027-01-01T00:00:00-06:00
# Development only: pretend "now" is this moment (the clock keeps ticking from there).
# Lets you test 2027 §25F gifts in Stripe test mode before giving opens. Refused in production.
DEV_CLOCK=2027-01-15T10:00:00-06:00

# Seed
SEED_OWNER_EMAIL=owner@tennissa.test
SEED_ORG_EIN=00-0000000
